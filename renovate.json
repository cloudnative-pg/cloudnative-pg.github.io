{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":gitSignOff",
    ":semanticCommitType(chore)",
    ":labels(automated,no-issue)",
    "customManagers:githubActionsVersions",
    ":automergeMinor",
    ":automergeDigest",
    "helpers:pinGitHubActionDigests"
  ],
  "enabled": true,
  "automergeStrategy": "rebase",
  "prConcurrentLimit": 5,
  "lockFileMaintenance": {
    "enabled": true
  },
  "semanticCommits": "enabled",
  "commitBodyTable": true,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^README\\.md$/"
      ],
      "matchStrings": [
        "hugomods/hugo:debian-reg-dart-sass-node-git-(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "hugo",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "packageNameTemplate": "gohugoio/hugo"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "tailwindcss"
      ],
      "allowedVersions": "<4"
    }
  ]
}
