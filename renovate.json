{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":gitSignOff",
    ":semanticCommitType(chore)",
    ":labels(automated,no-issue)",
    "customManagers:githubActionsVersions",
    ":automergeMinor",
    ":automergeDigest",
    "helpers:pinGitHubActionDigests"
  ],
  "enabled": true,
  "automergeStrategy": "rebase",
  "prConcurrentLimit": 5,
  "lockFileMaintenance": {
    "enabled": true
  },
  "semanticCommits": "enabled",
  "commitBodyTable": true,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^README\\.md$/"
      ],
      "matchStrings": [
        "(?<depName>ghcr\\.io/gohugoio/hugo):(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "gohugoio/hugo",
        "ghcr.io/gohugoio/hugo"
      ],
      "groupName": "hugo"
    }
  ]
}
